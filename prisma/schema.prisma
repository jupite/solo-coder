generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  gameRecords  GameRecord[]
  userLevels   UserLevel[]
  duoGameRecords DuoGameRecord[]
  duoLevels    DuoLevel[]
  duoGravityLevels DuoGravityLevel[]
  duoGravityGameRecords DuoGravityGameRecord[]
}

model GameRecord {
  id         String   @id @default(cuid())
  userId     String
  levelId    String
  bestTime   Float?
  bestSteps  Int?
  lastPlayed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId, levelId])
}

model UserLevel {
  id        String   @id @default(cuid())
  userId    String
  name      String
  gridData  String
  playerX   Int
  playerY   Int
  boxes     String
  targets   String
  verified  Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DuoLevel {
  id          String   @id @default(cuid())
  userId      String
  name        String
  gridData    String
  bluePlayerX Int
  bluePlayerY Int
  redPlayerX  Int
  redPlayerY  Int
  blueMaxSteps Int    @default(20)
  redMaxSteps  Int    @default(20)
  boxes       String
  targets     String
  redGates    String   // JSON array of {x,y,switchId}
  switches    String   // JSON array of {x,y,gateId}
  verified    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DuoGameRecord {
  id         String   @id @default(cuid())
  userId     String
  levelId    String
  bestTime   Float?
  bestSteps  Int?
  lastPlayed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId, levelId])
}

model DuoGravityLevel {
  id          String   @id @default(cuid())
  userId      String
  name        String
  gridData    String
  bluePlayerX Int
  bluePlayerY Int
  redPlayerX  Int
  redPlayerY  Int
  boxes       String
  targets     String
  verified    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DuoGravityGameRecord {
  id         String   @id @default(cuid())
  userId     String
  levelId    String
  bestTime   Float?
  bestSteps  Int?
  lastPlayed DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId, levelId])
}
